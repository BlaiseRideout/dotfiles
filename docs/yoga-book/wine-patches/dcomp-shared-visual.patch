+/* Renders the visual tree of a target created from a shared visual handle and publishes it for
+ * the visual created from the same handle */
+static HRESULT do_composite_shared_target(struct composition_target *target)
+{
+    struct composition_visual *root = impl_from_IDCompositionVisual(target->root);
+    LONG width = 0, height = 0;
+    HRESULT hr;
+
+    get_visual_tree_extent(root, 0, 0, &width, &height);
+    if (width <= 0 || height <= 0)
+        return S_OK;
+    width = min(width, 8192);
+    height = min(height, 8192);
+
+    if (!shared_producer_resize(target->shared_data, &target->producer, width, height))
+        return E_FAIL;
+
+    shared_producer_clear(&target->producer);
+    hr = do_composite(target, root, target->producer.dc, 0, 0);
+    shared_producer_publish(target->shared_data, &target->producer);
+    return hr;
+}
 
