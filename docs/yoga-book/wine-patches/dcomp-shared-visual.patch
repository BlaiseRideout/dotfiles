+/* Composes what the targets of this process show in a window and its children. Those targets
+ * stop being composed on screen. */
+static void do_composite_window(const struct composition_target *target, HWND hwnd, HDC offscreen_dc,
+                                int x, int y)
+{
+    struct composition_device *device;
+    struct composition_target *other;
+    POINT pt;
+
+    LIST_FOR_EACH_ENTRY(device, &devices, struct composition_device, entry)
+    {
+        LIST_FOR_EACH_ENTRY(other, &device->targets, struct composition_target, entry)
+        {
+            if (other == target || other->shared_data || !other->hwnd)
+                continue;
+            if (other->hwnd != hwnd && !IsChild(hwnd, other->hwnd))
+                continue;
+            if (!other->redirected)
+            {
+                FIXME("Redirecting the target for window %p into the surface of window %p.\n", other->hwnd, hwnd);
+                other->redirected = TRUE;
+            }
+            if (!other->root)
+                continue;
+
+            pt.x = pt.y = 0;
+            if (other->hwnd != hwnd)
+                MapWindowPoints(other->hwnd, hwnd, &pt, 1);
+            do_composite(target, impl_from_IDCompositionVisual(other->root), offscreen_dc, x + pt.x, y + pt.y);
+        }
+    }
