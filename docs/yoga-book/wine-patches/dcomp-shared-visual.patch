diff --color -urN a/dlls/dcomp/shared.c b/dlls/dcomp/shared.c
--- a/dlls/dcomp/shared.c	1969-12-31 16:00:00.000000000 -0800
+++ b/dlls/dcomp/shared.c	2026-11-09 12:19:27.064465634 -0800
@@ -0,0 +1,442 @@
+/*
+ * Cross-process shared visuals.
+ *
+ * A shared visual handle is a handle to a small page-file backed section holding a
+ * struct shared_visual_data. The process that owns the composition target created from the handle
+ * (the producer) renders its visual tree into a named section holding BGRA pixels; the process
+ * that owns the visual created from the handle (the consumer) blends those pixels into its own
+ * target. No wineserver support is needed, and the same path serves a single process.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "dcomp_private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+#define SHARED_VISUAL_MAGIC 0x56534357 /* "WCSV" */
+#define SHARED_VISUAL_SIZE  4096
+
+static LONG shared_visual_seq;
+
+static void frame_name(const struct shared_visual_data *data, LONG gen, WCHAR *name, unsigned int len)
+{
+    swprintf(name, len, L"wine_dcomp_frame_%08lx_%08lx_%ld", data->id_pid, data->id_seq, gen);
+}
+
+HANDLE shared_visual_create(void)
+{
+    struct shared_visual_data *data;
+    HANDLE handle;
+
+    handle = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0, SHARED_VISUAL_SIZE, NULL);
+    if (!handle)
+    {
+        ERR("Failed to create a section, error %lu.\n", GetLastError());
+        return NULL;
+    }
+
+    if (!(data = MapViewOfFile(handle, FILE_MAP_ALL_ACCESS, 0, 0, SHARED_VISUAL_SIZE)))
+    {
+        ERR("Failed to map the section, error %lu.\n", GetLastError());
+        CloseHandle(handle);
+        return NULL;
+    }
+    data->id_pid = GetCurrentProcessId();
+    data->id_seq = InterlockedIncrement(&shared_visual_seq);
+    data->magic = SHARED_VISUAL_MAGIC;
+    UnmapViewOfFile(data);
+    return handle;
+}
+
+/* Duplicates the handle and maps its data. */
+struct shared_visual_data *shared_visual_open(HANDLE handle, HANDLE *new_handle)
+{
+    struct shared_visual_data *data;
+
+    *new_handle = NULL;
+    if (!DuplicateHandle(GetCurrentProcess(), handle, GetCurrentProcess(), new_handle, 0, FALSE,
+                         DUPLICATE_SAME_ACCESS))
+    {
+        ERR("Cannot duplicate handle %p, error %lu.\n", handle, GetLastError());
+        return NULL;
+    }
+
+    if (!(data = MapViewOfFile(*new_handle, FILE_MAP_ALL_ACCESS, 0, 0, SHARED_VISUAL_SIZE))
+            || data->magic != SHARED_VISUAL_MAGIC)
+    {
+        ERR("Handle %p is not a shared visual, error %lu.\n", handle, GetLastError());
+        if (data)
+            UnmapViewOfFile(data);
+        CloseHandle(*new_handle);
+        *new_handle = NULL;
+        return NULL;
+    }
+
+    return data;
+}
+
+void shared_visual_close(HANDLE handle, struct shared_visual_data *data)
+{
+    if (data)
+        UnmapViewOfFile(data);
+    if (handle)
+        CloseHandle(handle);
+}
+
+void shared_producer_destroy(struct shared_frame_producer *producer)
+{
+    if (producer->dc)
+    {
+        SelectObject(producer->dc, producer->old_bitmap);
+        DeleteDC(producer->dc);
+    }
+    if (producer->bitmap)
+        DeleteObject(producer->bitmap);
+    if (producer->view)
+        UnmapViewOfFile(producer->view);
+    if (producer->section)
+        CloseHandle(producer->section);
+    memset(producer, 0, sizeof(*producer));
+}
+
+static HBITMAP create_dib(LONG width, LONG height, HANDLE section, void **bits)
+{
+    BITMAPINFO info;
+
+    memset(&info, 0, sizeof(info));
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -height;
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    return CreateDIBSection(NULL, &info, DIB_RGB_COLORS, bits, section, 0);
+}
+
+/* Makes the producer's private frame and the published frame width x height. */
+BOOL shared_producer_resize(struct shared_visual_data *data, struct shared_frame_producer *producer,
+                            LONG width, LONG height)
+{
+    WCHAR name[64];
+    LONG gen;
+
+    if (producer->dc && producer->width == width && producer->height == height)
+        return TRUE;
+
+    shared_producer_destroy(producer);
+
+    gen = InterlockedIncrement(&data->last_gen);
+    frame_name(data, gen, name, ARRAY_SIZE(name));
+    producer->section = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0,
+                                           width * height * 4, name);
+    if (!producer->section)
+    {
+        ERR("Failed to create frame section %s, error %lu.\n", debugstr_w(name), GetLastError());
+        return FALSE;
+    }
+    producer->view = MapViewOfFile(producer->section, FILE_MAP_ALL_ACCESS, 0, 0, width * height * 4);
+    producer->bitmap = create_dib(width, height, NULL, &producer->bits);
+    producer->dc = CreateCompatibleDC(NULL);
+    if (!producer->view || !producer->bitmap || !producer->dc)
+    {
+        ERR("Failed to create a %ldx%ld frame, error %lu.\n", width, height, GetLastError());
+        shared_producer_destroy(producer);
+        return FALSE;
+    }
+    producer->old_bitmap = SelectObject(producer->dc, producer->bitmap);
+    producer->width = width;
+    producer->height = height;
+
+    data->width = width;
+    data->height = height;
+    InterlockedExchange(&data->gen, gen);
+    FIXME("Publishing a %ldx%ld shared visual frame as %s.\n", width, height, debugstr_w(name));
+    return TRUE;
+}
+
+void shared_producer_clear(struct shared_frame_producer *producer)
+{
+    GdiFlush();
+    memset(producer->bits, 0, producer->width * producer->height * 4);
+}
+
+void shared_producer_publish(struct shared_visual_data *data, struct shared_frame_producer *producer)
+{
+    GdiFlush();
+    memcpy(producer->view, producer->bits, producer->width * producer->height * 4);
+    InterlockedIncrement(&data->seq);
+}
+
+void shared_consumer_destroy(struct shared_frame_consumer *consumer)
+{
+    if (consumer->dc)
+    {
+        SelectObject(consumer->dc, consumer->old_bitmap);
+        DeleteDC(consumer->dc);
+    }
+    if (consumer->bitmap)
+        DeleteObject(consumer->bitmap);
+    if (consumer->section)
+        CloseHandle(consumer->section);
+    memset(consumer, 0, sizeof(*consumer));
+}
+
+/* Returns a DC holding the most recent frame, or NULL when nothing was published yet. */
+HDC shared_consumer_get_dc(struct shared_visual_data *data, struct shared_frame_consumer *consumer,
+                           LONG *width, LONG *height)
+{
+    LONG gen = data->gen;
+    WCHAR name[64];
+    void *bits;
+
+    if (!gen)
+        return NULL;
+
+    if (gen != consumer->gen || !consumer->dc)
+    {
+        LONG w = data->width, h = data->height;
+
+        shared_consumer_destroy(consumer);
+        if (w <= 0 || h <= 0)
+            return NULL;
+
+        frame_name(data, gen, name, ARRAY_SIZE(name));
+        if (!(consumer->section = OpenFileMappingW(FILE_MAP_ALL_ACCESS, FALSE, name)))
+        {
+            WARN("Failed to open frame section %s, error %lu.\n", debugstr_w(name), GetLastError());
+            return NULL;
+        }
+        consumer->bitmap = create_dib(w, h, consumer->section, &bits);
+        consumer->dc = CreateCompatibleDC(NULL);
+        if (!consumer->bitmap || !consumer->dc)
+        {
+            ERR("Failed to create a %ldx%ld frame view, error %lu.\n", w, h, GetLastError());
+            shared_consumer_destroy(consumer);
+            return NULL;
+        }
+        consumer->old_bitmap = SelectObject(consumer->dc, consumer->bitmap);
+        consumer->width = w;
+        consumer->height = h;
+        consumer->gen = gen;
+        FIXME("Showing %ldx%ld shared visual frame %s.\n", w, h, debugstr_w(name));
+    }
+
+    *width = consumer->width;
+    *height = consumer->height;
+    return consumer->dc;
+}
+
+/* Window surface, from IDCompositionDevice::CreateSurfaceFromHwnd(). It stands for everything
+ * that is composed into the window and its children by targets of this process. */
+
+const GUID IID_wine_dcomp_hwnd_surface = {0x6b7a4f0e, 0x3c52, 0x4d0b, {0x9d, 0x1e, 0x57, 0x49, 0x4e, 0x45, 0x48, 0x53}};
+
+struct hwnd_surface
+{
+    IUnknown IUnknown_iface;
+    HWND hwnd;
+    LONG ref;
+};
+
+static HRESULT STDMETHODCALLTYPE hwnd_surface_QueryInterface(IUnknown *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_wine_dcomp_hwnd_surface))
+    {
+        IUnknown_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE hwnd_surface_AddRef(IUnknown *iface)
+{
+    struct hwnd_surface *surface = CONTAINING_RECORD(iface, struct hwnd_surface, IUnknown_iface);
+    return InterlockedIncrement(&surface->ref);
+}
+
+static ULONG STDMETHODCALLTYPE hwnd_surface_Release(IUnknown *iface)
+{
+    struct hwnd_surface *surface = CONTAINING_RECORD(iface, struct hwnd_surface, IUnknown_iface);
+    ULONG ref = InterlockedDecrement(&surface->ref);
+
+    if (!ref)
+        free(surface);
+    return ref;
+}
+
+static const struct IUnknownVtbl hwnd_surface_vtbl =
+{
+    hwnd_surface_QueryInterface,
+    hwnd_surface_AddRef,
+    hwnd_surface_Release,
+};
+
+HRESULT create_hwnd_surface(HWND hwnd, IUnknown **out)
+{
+    struct hwnd_surface *surface;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+    if (!IsWindow(hwnd))
+        return E_INVALIDARG;
+
+    if (!(surface = calloc(1, sizeof(*surface))))
+        return E_OUTOFMEMORY;
+    surface->IUnknown_iface.lpVtbl = &hwnd_surface_vtbl;
+    surface->hwnd = hwnd;
+    surface->ref = 1;
+    *out = &surface->IUnknown_iface;
+    return S_OK;
+}
+
+/* Returns the window of a window surface, NULL for anything else */
+HWND get_hwnd_surface_window(IUnknown *unknown)
+{
+    IUnknown *surface;
+    HWND hwnd;
+
+    if (!unknown || FAILED(IUnknown_QueryInterface(unknown, &IID_wine_dcomp_hwnd_surface, (void **)&surface)))
+        return NULL;
+    hwnd = CONTAINING_RECORD(surface, struct hwnd_surface, IUnknown_iface)->hwnd;
+    IUnknown_Release(surface);
+    return hwnd;
+}
+
+/* Scale transform. The values are kept but not applied. */
+
+struct scale_transform
+{
+    IDCompositionScaleTransform IDCompositionScaleTransform_iface;
+    float scale_x, scale_y, center_x, center_y;
+    LONG ref;
+};
+
+static inline struct scale_transform *impl_from_IDCompositionScaleTransform(IDCompositionScaleTransform *iface)
+{
+    return CONTAINING_RECORD(iface, struct scale_transform, IDCompositionScaleTransform_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE scale_transform_QueryInterface(IDCompositionScaleTransform *iface,
+        REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDCompositionEffect)
+            || IsEqualGUID(iid, &IID_IDCompositionTransform3D) || IsEqualGUID(iid, &IID_IDCompositionTransform)
+            || IsEqualGUID(iid, &IID_IDCompositionScaleTransform))
+    {
+        IDCompositionScaleTransform_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    FIXME("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE scale_transform_AddRef(IDCompositionScaleTransform *iface)
+{
+    return InterlockedIncrement(&impl_from_IDCompositionScaleTransform(iface)->ref);
+}
+
+static ULONG STDMETHODCALLTYPE scale_transform_Release(IDCompositionScaleTransform *iface)
+{
+    struct scale_transform *transform = impl_from_IDCompositionScaleTransform(iface);
+    ULONG ref = InterlockedDecrement(&transform->ref);
+
+    if (!ref)
+        free(transform);
+    return ref;
+}
+
+static HRESULT STDMETHODCALLTYPE scale_transform_SetAnimation(IDCompositionScaleTransform *iface,
+        IDCompositionAnimation *animation)
+{
+    FIXME("iface %p, animation %p stub!\n", iface, animation);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE scale_transform_SetScaleX(IDCompositionScaleTransform *iface, float scale)
+{
+    if (scale != 1.0f)
+        FIXME("iface %p, scale %f is not applied.\n", iface, scale);
+    impl_from_IDCompositionScaleTransform(iface)->scale_x = scale;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE scale_transform_SetScaleY(IDCompositionScaleTransform *iface, float scale)
+{
+    if (scale != 1.0f)
+        FIXME("iface %p, scale %f is not applied.\n", iface, scale);
+    impl_from_IDCompositionScaleTransform(iface)->scale_y = scale;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE scale_transform_SetCenterX(IDCompositionScaleTransform *iface, float center)
+{
+    TRACE("iface %p, center %f.\n", iface, center);
+    impl_from_IDCompositionScaleTransform(iface)->center_x = center;
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE scale_transform_SetCenterY(IDCompositionScaleTransform *iface, float center)
+{
+    TRACE("iface %p, center %f.\n", iface, center);
+    impl_from_IDCompositionScaleTransform(iface)->center_y = center;
+    return S_OK;
+}
+
+static const struct IDCompositionScaleTransformVtbl scale_transform_vtbl =
+{
+    scale_transform_QueryInterface,
+    scale_transform_AddRef,
+    scale_transform_Release,
+    scale_transform_SetAnimation,
+    scale_transform_SetScaleX,
+    scale_transform_SetAnimation,
+    scale_transform_SetScaleY,
+    scale_transform_SetAnimation,
+    scale_transform_SetCenterX,
+    scale_transform_SetAnimation,
+    scale_transform_SetCenterY,
+};
+
+HRESULT create_scale_transform(IDCompositionScaleTransform **out)
+{
+    struct scale_transform *transform;
+
+    if (!out)
+        return E_INVALIDARG;
+    if (!(transform = calloc(1, sizeof(*transform))))
+        return E_OUTOFMEMORY;
+    transform->IDCompositionScaleTransform_iface.lpVtbl = &scale_transform_vtbl;
+    transform->scale_x = transform->scale_y = 1.0f;
+    transform->ref = 1;
+    *out = &transform->IDCompositionScaleTransform_iface;
+    return S_OK;
+}
