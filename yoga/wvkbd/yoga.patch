+// Let go of every latched modifier: the key-up for each modifier key that is held down
+// (a latched Shift is KEY_LEFTSHIFT pressed and kept pressed), then an empty modifier state.
+// Used when the keyboard goes away by any road: hide, the compositor closing our surface,
+// SIGTERM/SIGINT/SIGHUP, a normal exit. Without the key-up the compositor can keep the
+// modifier down for the whole session, with nothing on screen to show or clear it.
+static void
+release_latched_mods(void)
+{
+    if (!keyboard.mods || !keyboard.vkbd) {
+        return;
+    }
+    uint32_t time = (uint32_t) (monotime() + keyboard.last_press_offset);
+    zwp_virtual_keyboard_v1_key_mods(keyboard.vkbd, time, keyboard.mods,
+                                     WL_KEYBOARD_KEY_STATE_RELEASED);
+    keyboard.mods = 0;
+    zwp_virtual_keyboard_v1_modifiers(keyboard.vkbd, 0, 0, 0, 0);
+    wl_display_flush(display);
+}
