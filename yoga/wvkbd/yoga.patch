+/* Autocorrect for the Yoga on-screen keyboard (included by keyboard.c).
+ *
+ * The keyboard only sends key events, so it cannot read the text field. It keeps its own
+ * buffer of the letters typed since the last word break and, when a space / Enter / . , ; ! ? )
+ * is pressed after a word that is not in the dictionary, replaces that word (backspaces, then
+ * the corrected letters) by the most frequent dictionary word one edit away (a letter missing,
+ * extra, wrong or two swapped). Then the delimiter goes through as usual.
+ *
+ * It stays out of the way: nothing is touched after digits or symbols inside a token (paths, URLs,
+ * identifiers), with Ctrl/Alt/Super/AltGr held, for words shorter than 3 letters, for words with
+ * capitals past the first letter, or when the buffer went stale (5 s idle, arrows, a layer switch).
+ * Backspace pressed right after a correction undoes it, and the word is added to the "known" file so
+ * it is never corrected again. The Auto key (or SIGRTMIN+2, re-reading the state file) turns it on
+ * and off; the state is a file so it survives restarts of the keyboard.
+ *
+ *   words file: one word per line, most frequent first   known file: one word per line
+ */
+#ifndef YOGA_AUTOCORRECT_H
+#define YOGA_AUTOCORRECT_H
+#include <stdlib.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <stdio.h>
+#include <ctype.h>
+#include <time.h>
+#include <math.h>
+
+#define AC_MAXW 24
+#define AC_IDLE_MS 5000
+#define AC_NONE UINT32_MAX
+
+struct ac_ent { char *w; uint32_t rank; };
+static struct {
+    struct ac_ent *tab;
+    size_t cap, n;
+    bool loaded, enabled;
+    char *state_path, *known_path;
+    char word[AC_MAXW + 2];
+    bool up[AC_MAXW + 2];
+    size_t len;
+    bool poison, nocorrect;
+    char prev[AC_MAXW + 2];       /* the word before the one being typed ("" when unknown) */
+    struct ac_big { char *k; uint32_t c; } *big;   /* bigram counts: "a b" -> n, and "a" -> total after a */
+    size_t bigcap, bign;
+    struct ac_next { char *k; char *n[3]; } *nx;   /* the three likeliest words after k */
+    size_t nxcap, nxn;
+    char sugg[3][AC_MAXW + 2];    /* the suggestion slots, as dictionary words ("" = empty) */
+    bool sugg_cap[3];             /* ... shown / typed with a capital first letter */
+    bool sugg_lit;                /* slot 0 is the word as typed (keep it), not a suggestion */
+    char label[3][AC_MAXW + 6];
+    int64_t last_ms;
+    bool undo_ok, undo_cap;
+    char undo_orig[AC_MAXW + 2], undo_fixed[AC_MAXW + 4];
+} ac = { .enabled = true };
+
+static uint32_t
+ac_hash(const char *s)
+{
+    uint32_t h = 2166136261u;
+    while (*s) {
+        h ^= (unsigned char)*s++;
+        h *= 16777619u;
+    }
+    return h;
+}
+
+static void
+ac_put(const char *w, uint32_t rank)
+{
+    if (ac.n * 2 >= ac.cap) {
+        struct ac_ent *old = ac.tab;
+        size_t oldcap = ac.cap;
+        ac.cap = oldcap ? oldcap * 2 : 1 << 16;
+        ac.tab = calloc(ac.cap, sizeof(*ac.tab));
+        for (size_t i = 0; i < oldcap; i++) {
+            if (!old[i].w) continue;
+            size_t j = ac_hash(old[i].w) & (ac.cap - 1);
+            while (ac.tab[j].w) j = (j + 1) & (ac.cap - 1);
+            ac.tab[j] = old[i];
+        }
+        free(old);
+    }
+    size_t i = ac_hash(w) & (ac.cap - 1);
+    while (ac.tab[i].w) {
+        if (!strcmp(ac.tab[i].w, w)) {
+            if (rank < ac.tab[i].rank) ac.tab[i].rank = rank;
+            return;
+        }
+        i = (i + 1) & (ac.cap - 1);
+    }
+    ac.tab[i].w = strdup(w);
+    ac.tab[i].rank = rank;
+    ac.n++;
+}
+
+static uint32_t
+ac_rank(const char *w)
+{
+    if (!ac.cap) return AC_NONE;
+    size_t i = ac_hash(w) & (ac.cap - 1);
+    while (ac.tab[i].w) {
+        if (!strcmp(ac.tab[i].w, w)) return ac.tab[i].rank;
+        i = (i + 1) & (ac.cap - 1);
+    }
+    return AC_NONE;
+}
+
+static void
+ac_big_add(const char *k, uint32_t c)
+{
+    if (ac.bign * 2 >= ac.bigcap) {
+        struct ac_big *old = ac.big;
+        size_t oldcap = ac.bigcap;
+        ac.bigcap = oldcap ? oldcap * 2 : 1 << 18;
+        ac.big = calloc(ac.bigcap, sizeof(*ac.big));
+        for (size_t i = 0; i < oldcap; i++) {
+            if (!old[i].k) continue;
+            size_t j = ac_hash(old[i].k) & (ac.bigcap - 1);
+            while (ac.big[j].k) j = (j + 1) & (ac.bigcap - 1);
+            ac.big[j] = old[i];
+        }
+        free(old);
+    }
+    size_t i = ac_hash(k) & (ac.bigcap - 1);
+    while (ac.big[i].k) {
+        if (!strcmp(ac.big[i].k, k)) { ac.big[i].c += c; return; }
+        i = (i + 1) & (ac.bigcap - 1);
+    }
+    ac.big[i].k = strdup(k);
+    ac.big[i].c = c;
+    ac.bign++;
+}
+
+static uint32_t
+ac_big_get(const char *k)
+{
+    if (!ac.bigcap) return 0;
+    size_t i = ac_hash(k) & (ac.bigcap - 1);
+    while (ac.big[i].k) {
+        if (!strcmp(ac.big[i].k, k)) return ac.big[i].c;
+        i = (i + 1) & (ac.bigcap - 1);
+    }
+    return 0;
+}
+
+static void
+ac_next_add(const char *a, const char *b)
+{
+    if (ac.nxn * 2 >= ac.nxcap) {
+        struct ac_next *old = ac.nx;
+        size_t oldcap = ac.nxcap;
+        ac.nxcap = oldcap ? oldcap * 2 : 1 << 16;
+        ac.nx = calloc(ac.nxcap, sizeof(*ac.nx));
+        for (size_t i = 0; i < oldcap; i++) {
+            if (!old[i].k) continue;
+            size_t j = ac_hash(old[i].k) & (ac.nxcap - 1);
+            while (ac.nx[j].k) j = (j + 1) & (ac.nxcap - 1);
+            ac.nx[j] = old[i];
+        }
+        free(old);
+    }
+    size_t i = ac_hash(a) & (ac.nxcap - 1);
+    while (ac.nx[i].k && strcmp(ac.nx[i].k, a)) i = (i + 1) & (ac.nxcap - 1);
+    if (!ac.nx[i].k) { ac.nx[i].k = strdup(a); ac.nxn++; }
+    for (int s = 0; s < 3; s++)       /* the file is in descending count order: the first three win */
+        if (!ac.nx[i].n[s]) { ac.nx[i].n[s] = strdup(b); return; }
+}
+
+static const struct ac_next *
+ac_next_get(const char *a)
+{
+    if (!ac.nxcap) return NULL;
+    size_t i = ac_hash(a) & (ac.nxcap - 1);
+    while (ac.nx[i].k) {
+        if (!strcmp(ac.nx[i].k, a)) return &ac.nx[i];
+        i = (i + 1) & (ac.nxcap - 1);
+    }
+    return NULL;
+}
+
+/* file lines: "word1 word2 count" */
+static void
+ac_load_bigrams(const char *path)
+{
+    FILE *f = fopen(path, "r");
+    if (!f) return;
+    char line[160], a[AC_MAXW + 2], key[2 * AC_MAXW + 4];
+    while (fgets(line, sizeof line, f)) {
+        char b[AC_MAXW + 2];
+        unsigned long n;
+        if (sscanf(line, "%24s %24s %lu", a, b, &n) != 3 || n > 0xffffffffu / 2) continue;
+        snprintf(key, sizeof key, "%s %s", a, b);
+        ac_big_add(key, (uint32_t)n);
+        ac_big_add(a, (uint32_t)n);                  /* the total after a */
+        ac_next_add(a, b);
+    }
+    fclose(f);
+}
+
+static void
+ac_load(const char *path, bool known)
+{
+    FILE *f = fopen(path, "r");
+    if (!f) return;
+    char line[128];
+    uint32_t rank = 1;
+    while (fgets(line, sizeof line, f)) {
+        size_t l = strcspn(line, " \t\r\n");
+        line[l] = 0;
+        if (!l || l > AC_MAXW) continue;
+        bool ok = true;
+        for (size_t i = 0; i < l; i++) {
+            line[i] = tolower((unsigned char)line[i]);
+            if (!(line[i] >= 'a' && line[i] <= 'z') && line[i] != '\'') ok = false;
+        }
+        if (ok) ac_put(line, known ? 0 : rank++);
+    }
+    fclose(f);
+    if (ac.n) ac.loaded = true;
+}
+
+/* Key positions on the on-screen layout (Dvorak, each row offset like its keys), in key units.
+ * A slip lands on a neighbouring key far more often than on a distant one, so substituting a
+ * letter costs by how far apart the two keys are. */
+static bool
+ac_keypos(char c, double *x, double *y)
+{
+    static const struct { const char *keys; double x0; } rows[] = {
+        { "',.pyfgcrl", 1.5 }, { "aoeuidhtns", 1.75 }, { ";qjkxbmwvz", 2.25 } };
+    for (int r = 0; r < 3; r++)
+        for (int i = 0; rows[r].keys[i]; i++)
+            if (rows[r].keys[i] == c) {
+                *x = rows[r].x0 + i + 0.5;
+                *y = r;
+                return true;
+            }
+    return false;
+}
+
+static double
+ac_subcost_calc(char a, char b)
+{
+    double ax, ay, bx, by;
+    if (!ac_keypos(a, &ax, &ay) || !ac_keypos(b, &bx, &by)) return 2.0;
+    double d = sqrt((ax - bx) * (ax - bx) + (ay - by) * (ay - by));   /* 1.0 = the next key */
+    double c = 0.3 + 0.5 * d;                         /* next key 0.8, two keys over 1.3, far 1.8+ */
+    return c > 2.0 ? 2.0 : c;
+}
+
+/* every pair, computed once: the distance routine below runs millions of cells per word */
+static float ac_sub[128][128];
+static bool ac_sub_ready;
+static void
+ac_sub_init(void)
+{
+    if (ac_sub_ready) return;
+    for (int a = 0; a < 128; a++)
+        for (int b = 0; b < 128; b++)
+            ac_sub[a][b] = (float)ac_subcost_calc((char)a, (char)b);
+    ac_sub_ready = true;
+}
+
+#define AC_MAXCOST 2.0   /* a word further than this from what was typed is not offered */
+
+/* Weighted edit distance from what was typed (a) to a dictionary word (b): slips by key distance,
+ * swapped neighbours cheap, a dropped / doubled / extra letter about one key away, a missing
+ * apostrophe nearly free (dont -> don't). Gives up once it cannot get under `limit`. */
+static double
+ac_dist(const char *a, size_t n, const char *b, size_t m, double limit)
+{
+    double d[AC_MAXW + 4][AC_MAXW + 4];
+    d[0][0] = 0;
+    for (size_t i = 1; i <= n; i++)
+        d[i][0] = d[i - 1][0] + (i > 1 && a[i - 1] == a[i - 2] ? 0.6 : 1.0);
+    for (size_t j = 1; j <= m; j++)
+        d[0][j] = d[0][j - 1] + (b[j - 1] == '\'' ? 0.2 : (j > 1 && b[j - 1] == b[j - 2] ? 0.6 : 1.0));
+    for (size_t i = 1; i <= n; i++) {
+        double rowmin = 1e9;
+        for (size_t j = 1; j <= m; j++) {
+            double sub = d[i - 1][j - 1] + (a[i - 1] == b[j - 1] ? 0.0 : ac_sub[(unsigned char)a[i - 1] & 127][(unsigned char)b[j - 1] & 127]);
+            double del = d[i - 1][j] + (i > 1 && a[i - 1] == a[i - 2] ? 0.6 : 1.0);   /* an extra letter typed */
+            double ins = d[i][j - 1] + (b[j - 1] == '\'' ? 0.2 : (j > 1 && b[j - 1] == b[j - 2] ? 0.6 : 0.75)); /* a letter left out (the commonest slip) */
+            double v = sub < del ? sub : del;
+            if (ins < v) v = ins;
+            if (i > 1 && j > 1 && a[i - 1] == b[j - 2] && a[i - 2] == b[j - 1] && a[i - 1] != a[i - 2]) {
+                double tr = d[i - 2][j - 2] + 0.6;                                    /* two swapped */
+                if (tr < v) v = tr;
+            }
+            d[i][j] = v;
+            if (v < rowmin) rowmin = v;
+        }
+        if (rowmin > limit) return 1e9;
+    }
+    return d[n][m];
+}
+
+/* ~log2 of a rank (rank 1 is the most frequent word) */
+static double
+ac_lg(uint32_t rank)
+{
+    uint32_t v = rank + 2;
+    int b = 0;
+    while (v >> (b + 1)) b++;
+    return b + (double)(v - (1u << b)) / (double)(1u << b);
+}
+
+/* A bonus for words that often follow the previous word (a bigram model: P(word | previous),
+ * counts from web text): up to 6 points when it nearly always does, about 2 for one time in a
+ * hundred, nothing for a pair never seen. In the same units as the score below, where one
+ * cost unit is worth 4. */
+static double
+ac_context_bonus(const char *cand)
+{
+    if (!ac.prev[0] || !ac.bigcap) return 0;
+    char key[2 * AC_MAXW + 4];
+    snprintf(key, sizeof key, "%s %s", ac.prev, cand);
+    uint32_t n = ac_big_get(key);
+    if (!n) return 0;
+    double cp = (double)n / (double)ac_big_get(ac.prev);
+    double b = 6.0 * (ac_lg((uint32_t)(cp * 1024.0)) - 1.0) / 9.0;
+    return b > 6.0 ? 6.0 : b;
+}
+
+struct ac_cand { char w[AC_MAXW + 2]; double sc; };
+
+static void
+ac_cand_add(struct ac_cand *c, int *n, int max, const char *w, double sc)
+{
+    for (int i = 0; i < *n; i++)
+        if (!strcmp(c[i].w, w)) {
+            if (sc >= c[i].sc) return;
+            for (; i + 1 < *n; i++) c[i] = c[i + 1];   /* drop the worse one, add again below */
+            (*n)--;
+            break;
+        }
+    if (*n == max && sc >= c[*n - 1].sc) return;
+    int i = *n < max ? (*n)++ : max - 1;
+    for (; i > 0 && c[i - 1].sc > sc; i--) c[i] = c[i - 1];
+    strcpy(c[i].w, w);
+    c[i].sc = sc;
+}
+
+
+/* ---- the lexicon and the cache -------------------------------------------------------------
+ * The scan below runs on a compact array of the words, sorted: a typed prefix is a binary search
+ * (completions), and the corrections only look at words of about the right length. Results are
+ * cached by (previous word, typed word): the user adds and removes one letter at a time, so a
+ * backspace hits the cache, and so does the correction at the space (it was worked out when the
+ * last letter was typed). */
+struct ac_lex { const char *w; uint32_t rank; uint8_t len; };
+static struct ac_lex *ac_lexi;
+static size_t ac_nlex;
+static bool ac_lex_dirty = true;
+
+static int
+ac_lex_cmp(const void *a, const void *b)
+{
+    return strcmp(((const struct ac_lex *)a)->w, ((const struct ac_lex *)b)->w);
+}
+
+struct ac_res {
+    bool used;
+    char prev[AC_MAXW + 2], word[AC_MAXW + 2];
+    char s[2][AC_MAXW + 2];          /* the two best suggestions (empty when there are none) */
+    char fix[AC_MAXW + 4];           /* the correction to make at a space ("" = leave it) */
+};
+#define AC_CACHE 1024
+static struct ac_res ac_cache[AC_CACHE];
+
+static void
+ac_cache_clear(void)
+{
+    memset(ac_cache, 0, sizeof ac_cache);
+    ac_lex_dirty = true;             /* (a learned word changes both) */
+}
+
+static void
+ac_lex_build(void)
+{
+    free(ac_lexi);
+    ac_lexi = malloc(sizeof(*ac_lexi) * (ac.n + 1));
+    ac_nlex = 0;
+    for (size_t k = 0; k < ac.cap; k++) {
+        if (!ac.tab[k].w) continue;
+        ac_lexi[ac_nlex].w = ac.tab[k].w;
+        ac_lexi[ac_nlex].rank = ac.tab[k].rank;
+        ac_lexi[ac_nlex].len = (uint8_t)strlen(ac.tab[k].w);
+        ac_nlex++;
+    }
+    qsort(ac_lexi, ac_nlex, sizeof(*ac_lexi), ac_lex_cmp);
+    ac_lex_dirty = false;
+    ac_sub_init();
+}
+
+/* What to offer for `word` after `prev`, and what to correct it to: the likeliest words by
+ *   4 x edit cost (key distance on the Dvorak layout, swaps, left-out letters) + 0.35 x log2(rank)
+ *   - the bigram bonus for following `prev`
+ * over completions of the typed prefix and corrections of it. The first letter is rarely the slip. */
+static const struct ac_res *
+ac_compute(const char *word, const char *prev)
+{
+    uint32_t h = ac_hash(prev) * 31u + ac_hash(word);
+    struct ac_res *r = &ac_cache[h & (AC_CACHE - 1)];
+    if (r->used && !strcmp(r->word, word) && !strcmp(r->prev, prev)) return r;
+    if (ac_lex_dirty) { memset(ac_cache, 0, sizeof ac_cache); ac_lex_build(); r = &ac_cache[h & (AC_CACHE - 1)]; }
+    memset(r, 0, sizeof *r);
+    r->used = true;
+    strcpy(r->word, word);
+    strcpy(r->prev, prev);
+
+    size_t n = strlen(word);
+    bool known = ac_rank(word) != AC_NONE;
+    struct ac_cand c[2];
+    int nc = 0;
+    double bestfix = 1e9;
+    /* (ac_context_bonus reads ac.prev: borrow it for `prev`) */
+    char saved[AC_MAXW + 2];
+    strcpy(saved, ac.prev);
+    strcpy(ac.prev, prev);
+
+    /* completions: the words starting with `word`, found by binary search */
+    size_t lo = 0, hi = ac_nlex;
+    while (lo < hi) {
+        size_t mid = (lo + hi) / 2;
+        if (strncmp(ac_lexi[mid].w, word, n) < 0) lo = mid + 1; else hi = mid;
+    }
+    for (size_t k = lo; k < ac_nlex && !strncmp(ac_lexi[k].w, word, n); k++) {
+        size_t m = ac_lexi[k].len;
+        if (m <= n) continue;
+        size_t extra = m - n;
+        double base = 4.0 * (0.3 + 0.1 * (extra > 6 ? 6 : extra)) + 0.35 * ac_lg(ac_lexi[k].rank);
+        if (nc == 2 && base - 6.0 >= c[1].sc) continue;           /* cannot make the top two */
+        ac_cand_add(c, &nc, 2, ac_lexi[k].w, base - ac_context_bonus(ac_lexi[k].w));
+    }
+    /* corrections: only words within two letters of the length */
+    if (n >= 2) {
+        for (size_t k = 0; k < ac_nlex; k++) {
+            size_t m = ac_lexi[k].len;
+            if ((m > n ? m - n : n - m) > 2) continue;
+            const char *w = ac_lexi[k].w;
+            if (m == n && !strcmp(w, word)) continue;
+            double cost = ac_dist(word, n, w, m, AC_MAXCOST);
+            if (cost > AC_MAXCOST) continue;
+            if (w[0] != word[0]) cost += 0.4;
+            if (cost > AC_MAXCOST + 0.4) continue;
+            double base = 4.0 * cost + 0.35 * ac_lg(ac_lexi[k].rank);
+            double lb = base - 6.0;                  /* the best it can get with the bigram bonus */
+            double pen = known ? 3.2 : 0.0;          /* it is a word: offer another only if much likelier */
+            bool want_fix = !known && lb < bestfix;
+            bool want_cand = (!known || cost <= AC_MAXCOST) && (nc < 2 || lb + pen < c[1].sc);
+            if (!want_fix && !want_cand) continue;
+            double sc = base - ac_context_bonus(w);
+            if (want_fix && sc < bestfix) { bestfix = sc; strcpy(r->fix, w); }
+            if (want_cand) ac_cand_add(c, &nc, 2, w, sc + pen);
+        }
+    }
+    for (int i = 0; i < nc; i++) strcpy(r->s[i], c[i].w);
+    strcpy(ac.prev, saved);
+    return r;
+}
+static int64_t
+ac_now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static void
+ac_reset_word(void)
+{
+    ac.len = 0;
+    ac.poison = false;
+    ac.nocorrect = false;
+}
+
+static uint32_t
+ac_code(char c)
+{
+    static const uint16_t L[26] = { KEY_A, KEY_B, KEY_C, KEY_D, KEY_E, KEY_F, KEY_G, KEY_H, KEY_I,
+        KEY_J, KEY_K, KEY_L, KEY_M, KEY_N, KEY_O, KEY_P, KEY_Q, KEY_R, KEY_S, KEY_T, KEY_U, KEY_V,
+        KEY_W, KEY_X, KEY_Y, KEY_Z };
+    return c == '\'' ? KEY_APOSTROPHE : L[c - 'a'];
+}
+
+static void
+ac_tap(struct kbd *kb, uint32_t time, uint32_t code)
+{
+    zwp_virtual_keyboard_v1_key(kb->vkbd, time, code, WL_KEYBOARD_KEY_STATE_PRESSED);
+    zwp_virtual_keyboard_v1_key(kb->vkbd, time, code, WL_KEYBOARD_KEY_STATE_RELEASED);
+}
+
+/* replace the last `erase` characters by s (first letter capital if cap0) */
+static void
+ac_replace(struct kbd *kb, uint32_t time, size_t erase, const char *s, bool cap0, bool space)
+{
+    zwp_virtual_keyboard_v1_modifiers(kb->vkbd, 0, 0, 0, 0);
+    for (size_t i = 0; i < erase; i++) ac_tap(kb, time, KEY_BACKSPACE);
+    for (size_t i = 0; s[i]; i++) {
+        zwp_virtual_keyboard_v1_modifiers(kb->vkbd, (i == 0 && cap0) ? Shift : 0, 0, 0, 0);
+        ac_tap(kb, time, dvorak_pos(ac_code(s[i])));
+    }
+    if (space) {
+        zwp_virtual_keyboard_v1_modifiers(kb->vkbd, 0, 0, 0, 0);
+        ac_tap(kb, time, dvorak_pos(KEY_SPACE));
+    }
+    zwp_virtual_keyboard_v1_modifiers(kb->vkbd, kb->mods, 0, 0, 0);
+}
+
+static void
+ac_learn(const char *w)
+{
+    ac_put(w, 0);
+    ac_cache_clear();
+    if (!ac.known_path) return;
+    FILE *f = fopen(ac.known_path, "a");
+    if (f) { fprintf(f, "%s\n", w); fclose(f); }
+}
+
+static bool
+ac_undo(struct kbd *kb, uint32_t time)
+{
+    /* the delimiter and the corrected word go; the typed word comes back and is not corrected again */
+    ac_replace(kb, time, 1 + strlen(ac.undo_fixed), ac.undo_orig, ac.undo_cap, false);
+    ac_learn(ac.undo_orig);
+    ac.len = strlen(ac.undo_orig);
+    memcpy(ac.word, ac.undo_orig, ac.len);
+    memset(ac.up, 0, sizeof ac.up);
+    ac.up[0] = ac.undo_cap;
+    ac.poison = false;
+    ac.nocorrect = true;
+    return true;
+}
+
+static bool
+ac_try_correct(struct kbd *kb, uint32_t time)
+{
+    ac.word[ac.len] = 0;
+    if (ac.word[ac.len - 1] == '\'') return false;
+    for (size_t i = 1; i < ac.len; i++)
+        if (ac.up[i]) return false;                   /* ALLCAPS, camelCase */
+    if (ac_rank(ac.word) != AC_NONE) return false;    /* a word we know */
+    const struct ac_res *res = ac_compute(ac.word, ac.prev);
+    if (!res->fix[0]) return false;
+    char fix[AC_MAXW + 4];
+    strcpy(fix, res->fix);
+    ac_replace(kb, time, ac.len, fix, ac.up[0], false);
+    strcpy(ac.undo_orig, ac.word);
+    strcpy(ac.undo_fixed, fix);
+    ac.undo_cap = ac.up[0];
+    ac.undo_ok = true;
+    return true;
+}
+
+/* Called for every key press before it is sent. Returns true when the press was handled here. */
+static bool
+ac_on_key_inner(struct kbd *kb, struct key *k, uint32_t time)
+{
+    if (!ac.enabled || !ac.loaded) return false;
+    bool undo = ac.undo_ok;
+    ac.undo_ok = false;
+    if (k->type == Mod) return false;
+    int64_t now = ac_now_ms();
+    if (now - ac.last_ms > AC_IDLE_MS) { ac_reset_word(); ac.prev[0] = 0; }
+    ac.last_ms = now;
+    if (k->type != Code || k->code_mod || (kb->mods & (Ctrl | Alt | Super | AltGr))) {
+        ac_reset_word();
+        ac.prev[0] = 0;
+        return false;
+    }
+    if (k->code == KEY_BACKSPACE) {
+        if (undo) return ac_undo(kb, time);
+        if (ac.len) ac.len--;
+        if (!ac.len) ac.nocorrect = false;
+        return false;
+    }
+    const char *lab = ((kb->mods & Shift) && k->shift_label && *k->shift_label) ? k->shift_label : k->label;
+    if (lab[0] && !lab[1] && isascii((unsigned char)lab[0]) && isalpha((unsigned char)lab[0])) {
+        if (ac.poison) return false;
+        if (ac.len >= AC_MAXW) { ac.poison = true; return false; }
+        ac.word[ac.len] = tolower((unsigned char)lab[0]);
+        ac.up[ac.len++] = (kb->mods & (Shift | CapsLock)) != 0;
+        return false;
+    }
+    if (k->code == KEY_APOSTROPHE && !(kb->mods & Shift)) {
+        if (!ac.poison && ac.len && ac.len < AC_MAXW) ac.word[ac.len++] = '\'';
+        return false;
+    }
+    bool white = k->code == KEY_SPACE || k->code == KEY_ENTER;
+    bool punct = lab[0] && !lab[1] && strchr(".,;!?)", lab[0]);
+    if (white || punct) {
+        /* before a period only longer words: www. e.g. i.e. */
+        char cur[AC_MAXW + 2] = "";
+        if (ac.len >= 1 && !ac.poison) { memcpy(cur, ac.word, ac.len); cur[ac.len] = 0; }
+        if (ac.len >= (lab[0] == '.' ? 4 : 3) && !ac.poison && !ac.nocorrect && ac_try_correct(kb, time))
+            strcpy(cur, ac.undo_fixed);
+        /* the word just finished is the context of the next one; a sentence end forgets it */
+        strcpy(ac.prev, (k->code == KEY_ENTER || lab[0] == '.' || lab[0] == '!' || lab[0] == '?') ? "" : cur);
+        ac_reset_word();
+        ac.poison = !white && lab[0] == '.';          /* file.txt, e.g., www.x.com: until the next space */
+        return false;
+    }
+    ac_reset_word();                                    /* digit, symbol, arrow...: not a plain word */
+    ac.prev[0] = 0;
+    ac.poison = true;
+    return false;
+}
+
+static void
+ac_read_state(void)
+{
+    ac.enabled = true;
+    if (!ac.state_path) return;
+    FILE *f = fopen(ac.state_path, "r");
+    if (!f) return;
+    char b[16] = "";
+    if (fgets(b, sizeof b, f) && !strncmp(b, "off", 3)) ac.enabled = false;
+    fclose(f);
+    ac_reset_word();
+    ac.undo_ok = false;
+}
+
+static void
+ac_set_enabled(bool on)
+{
+    ac.enabled = on;
+    ac_reset_word();
+    ac.undo_ok = false;
+    if (!ac.state_path) return;
+    FILE *f = fopen(ac.state_path, "w");
+    if (f) { fputs(on ? "on\n" : "off\n", f); fclose(f); }
+}
+
+/* ---- the suggestion row ---------------------------------------------------------------------
+ * Three slots like a phone keyboard's: while a word is being typed, [the word as typed | best |
+ * next best], the candidates being the completions of what is typed and the corrections of it
+ * (same scoring as the autocorrect, previous word included); between words, the three likeliest
+ * next words after the previous one. A tap puts the word in (replacing what was typed) and a space. */
+static void
+ac_suggest_update(void)
+{
+    memset(ac.sugg, 0, sizeof ac.sugg);
+    memset(ac.sugg_cap, 0, sizeof ac.sugg_cap);
+    ac.sugg_lit = false;
+    if (!ac.enabled || !ac.loaded || ac.poison) return;
+    if (ac.len == 0) {
+        const struct ac_next *nx = ac.prev[0] ? ac_next_get(ac.prev) : NULL;
+        static const char *start[3] = { "i", "the", "it" };
+        for (int i = 0; i < 3; i++) {
+            const char *w = nx ? nx->n[i] : start[i];
+            if (w) strcpy(ac.sugg[i], w);
+        }
+        return;
+    }
+    char word[AC_MAXW + 2];
+    memcpy(word, ac.word, ac.len);
+    word[ac.len] = 0;
+    strcpy(ac.sugg[0], word);
+    ac.sugg_lit = true;
+    ac.sugg_cap[0] = ac.up[0];
+    const struct ac_res *res = ac_compute(word, ac.prev);
+    for (int i = 0; i < 2; i++) {
+        strcpy(ac.sugg[1 + i], res->s[i]);
+        ac.sugg_cap[1 + i] = ac.up[0];
+    }
+}
+
+static const char *
+ac_label(unsigned slot)
+{
+    char *l = ac.label[slot > 2 ? 2 : slot];
+    const char *w = ac.sugg[slot > 2 ? 2 : slot];
+    if (!*w) { l[0] = 0; return l; }
+    char t[AC_MAXW + 4];
+    strcpy(t, w);
+    if (ac.sugg_cap[slot] || !strcmp(t, "i") || !strncmp(t, "i'", 2)) t[0] = toupper((unsigned char)t[0]);
+    if (slot == 0 && ac.sugg_lit) snprintf(l, AC_MAXW + 6, "\"%s\"", t);
+    else strcpy(l, t);
+    return l;
+}
+
+/* a tap on slot: the word in place of what was typed, then a space */
+static void
+ac_pick(struct kbd *kb, unsigned slot, uint32_t time)
+{
+    if (slot > 2 || !ac.sugg[slot][0]) return;
+    char w[AC_MAXW + 2];
+    strcpy(w, ac.sugg[slot]);
+    bool cap = ac.sugg_cap[slot] || !strcmp(w, "i") || !strncmp(w, "i'", 2);
+    if (slot == 0 && ac.sugg_lit) {
+        if (ac_rank(w) == AC_NONE) ac_learn(w);      /* kept as typed: never correct it again */
+        ac_replace(kb, time, 0, "", false, true);
+    } else {
+        ac_replace(kb, time, ac.len, w, cap, true);
+    }
+    strcpy(ac.prev, w);
+    ac_reset_word();
+    ac.undo_ok = false;
+    ac.last_ms = ac_now_ms();
+}
+
+static void ac_row_redraw(struct kbd *kb);
+
+/* every key press: track it (and correct), then bring the suggestions up to date */
+static bool
+ac_on_key(struct kbd *kb, struct key *k, uint32_t time)
+{
+    if (!ac.enabled || !ac.loaded) return false;
+    char old[3][AC_MAXW + 2];
+    bool old_cap[3], old_lit = ac.sugg_lit;
+    memcpy(old, ac.sugg, sizeof old);
+    memcpy(old_cap, ac.sugg_cap, sizeof old_cap);
+    bool r = ac_on_key_inner(kb, k, time);
+    ac_suggest_update();
+    if (memcmp(old, ac.sugg, sizeof old) || memcmp(old_cap, ac.sugg_cap, sizeof old_cap) || old_lit != ac.sugg_lit)
+        ac_row_redraw(kb);          /* (only when the row changed) */
+    return r;
+}
