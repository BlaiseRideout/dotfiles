+/* Touch bookkeeping. Shift/Ctrl/Alt are held by a finger, so several touches matter: each held
+ * modifier remembers the touch (id; -1 is the pointer) that holds it, and the typed key
+ * remembers its own, so lifting or moving one finger does not release another's key. */
+#define MAX_HELD 4
+static struct { int32_t id; struct key *key; } held_touch[MAX_HELD];
+static int32_t key_touch = -1000;
+static int touches_down = 0;   /* fingers on the keyboard right now */
+
+/* a line in $XDG_RUNTIME_DIR/yoga-osk-stuck.log: what the touch handling did that it normally does not */
+static void
+osk_log(const char *what, int n)
+{
+    const char *dir = getenv("XDG_RUNTIME_DIR");
+    char path[256];
+    snprintf(path, sizeof path, "%s/yoga-osk-stuck.log", dir ? dir : "/tmp");
+    FILE *f = fopen(path, "a");
+    if (f) {
+        fprintf(f, "%ld %s %d\n", (long)time(NULL), what, n);
+        fclose(f);
+    }
+}
+
+static void
+touch_press(int32_t id, struct key *k, uint32_t time)
+{
+    k = kbd_fn_remap(&keyboard, k);
+    if (!k) {
+        osk_log("touch down ignored: surface not configured", layer_surface_configured * 2 + popup_xdg_surface_configured);
+        return;
+    }
+    if (k->type == Mod && (k->code & HELD_MODS)) {
+        for (int i = 0; i < MAX_HELD; i++) {
+            if (!held_touch[i].key) {
+                held_touch[i].id = id;
+                held_touch[i].key = k;
+                kbd_press_key(&keyboard, k, time);
+                return;
+            }
+        }
+        return;
+    }
+    key_touch = id;
+    kbd_press_key(&keyboard, k, time);
+}
+
+static void
+touch_release(int32_t id, uint32_t time)
+{
+    for (int i = 0; i < MAX_HELD; i++) {
+        if (held_touch[i].key && held_touch[i].id == id) {
+            kbd_unhold_mod(&keyboard, held_touch[i].key, time);
+            held_touch[i].key = NULL;
+            return;
+        }
+    }
+    if (id == key_touch) {
+        key_touch = -1000;
+        kbd_release_key(&keyboard, time);
+    }
+}
