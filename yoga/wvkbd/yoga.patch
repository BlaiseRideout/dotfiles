+/* The system layout is Dvorak, so the compositor (keybindings!) maps a keycode through
+ * Dvorak. The layouts here are written with the natural (QWERTY) keycode of each
+ * character, so send the keycode of the physical key that carries that character in
+ * Dvorak instead. The latin keymap we upload is the matching Dvorak permutation, so
+ * clients that use it see the same character. */
+static uint32_t
+dvorak_pos(uint32_t code)
+{
+    static const uint16_t map[][2] = { {KEY_MINUS, KEY_APOSTROPHE}, {KEY_EQUAL, KEY_RIGHTBRACE}, {KEY_Q, KEY_X}, {KEY_W, KEY_COMMA}, {KEY_E, KEY_D}, {KEY_R, KEY_O}, {KEY_T, KEY_K}, {KEY_Y, KEY_T}, {KEY_U, KEY_F}, {KEY_I, KEY_G}, {KEY_O, KEY_S}, {KEY_P, KEY_R}, {KEY_LEFTBRACE, KEY_MINUS}, {KEY_RIGHTBRACE, KEY_EQUAL}, {KEY_A, KEY_A}, {KEY_S, KEY_SEMICOLON}, {KEY_D, KEY_H}, {KEY_F, KEY_Y}, {KEY_G, KEY_U}, {KEY_H, KEY_J}, {KEY_J, KEY_C}, {KEY_K, KEY_V}, {KEY_L, KEY_P}, {KEY_SEMICOLON, KEY_Z}, {KEY_APOSTROPHE, KEY_Q}, {KEY_Z, KEY_SLASH}, {KEY_X, KEY_B}, {KEY_C, KEY_I}, {KEY_V, KEY_DOT}, {KEY_B, KEY_N}, {KEY_N, KEY_L}, {KEY_M, KEY_M}, {KEY_COMMA, KEY_W}, {KEY_DOT, KEY_E}, {KEY_SLASH, KEY_LEFTBRACE} };
+    for (size_t i = 0; i < sizeof(map) / sizeof(map[0]); i++)
+        if (map[i][0] == code)
+            return map[i][1];
+    return code;
+}
+
+#include "autocorrect.h"
+
+void
+kbd_autocorrect_init(const char *words, const char *known, const char *state)
+{
+    if (state) ac.state_path = strdup(state);
+    if (known) ac.known_path = strdup(known);
+    if (words) ac_load(words, false);
+    if (known) ac_load(known, true);
+    ac_read_state();
+}
+
+void
+kbd_autocorrect_reload(void)
+{
+    ac_read_state();
+}
+
+void
+kbd_autocorrect_reset(void)
+{
+    ac_reset_word();
+    ac.undo_ok = false;
+}
