diff --git a/autocorrect.h b/autocorrect.h
new file mode 100644
index 0000000..f709e6b
--- /dev/null
+++ b/autocorrect.h
@@ -0,0 +1,310 @@
+/* Autocorrect for the Yoga on-screen keyboard (included by keyboard.c).
+ *
+ * The keyboard only sends key events, so it cannot read the text field. It keeps its own
+ * buffer of the letters typed since the last word break and, when a space / Enter / . , ; ! ? )
+ * is pressed after a word that is not in the dictionary, replaces that word (backspaces, then
+ * the corrected letters) by the most frequent dictionary word one edit away (a letter missing,
+ * extra, wrong or two swapped). Then the delimiter goes through as usual.
+ *
+ * It stays out of the way: nothing is touched after digits or symbols inside a token (paths, URLs,
+ * identifiers), with Ctrl/Alt/Super/AltGr held, for words shorter than 3 letters, for words with
+ * capitals past the first letter, or when the buffer went stale (5 s idle, arrows, a layer switch).
+ * Backspace pressed right after a correction undoes it, and the word is added to the "known" file so
+ * it is never corrected again. The Auto key (or SIGRTMIN+2, re-reading the state file) turns it on
+ * and off; the state is a file so it survives restarts of the keyboard.
+ *
+ *   words file: one word per line, most frequent first   known file: one word per line
+ */
+#ifndef YOGA_AUTOCORRECT_H
+#define YOGA_AUTOCORRECT_H
+#include <stdlib.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include <stdio.h>
+#include <ctype.h>
+#include <time.h>
+
+#define AC_MAXW 24
+#define AC_IDLE_MS 5000
+#define AC_NONE UINT32_MAX
+
+struct ac_ent { char *w; uint32_t rank; };
+static struct {
+    struct ac_ent *tab;
+    size_t cap, n;
+    bool loaded, enabled;
+    char *state_path, *known_path;
+    char word[AC_MAXW + 2];
+    bool up[AC_MAXW + 2];
+    size_t len;
+    bool poison, nocorrect;
+    int64_t last_ms;
+    bool undo_ok, undo_cap;
+    char undo_orig[AC_MAXW + 2], undo_fixed[AC_MAXW + 4];
+} ac = { .enabled = true };
+
+static uint32_t
+ac_hash(const char *s)
+{
+    uint32_t h = 2166136261u;
+    while (*s) {
+        h ^= (unsigned char)*s++;
+        h *= 16777619u;
+    }
+    return h;
+}
+
+static void
+ac_put(const char *w, uint32_t rank)
+{
+    if (ac.n * 2 >= ac.cap) {
+        struct ac_ent *old = ac.tab;
+        size_t oldcap = ac.cap;
+        ac.cap = oldcap ? oldcap * 2 : 1 << 16;
+        ac.tab = calloc(ac.cap, sizeof(*ac.tab));
+        for (size_t i = 0; i < oldcap; i++) {
+            if (!old[i].w) continue;
+            size_t j = ac_hash(old[i].w) & (ac.cap - 1);
+            while (ac.tab[j].w) j = (j + 1) & (ac.cap - 1);
+            ac.tab[j] = old[i];
+        }
+        free(old);
+    }
+    size_t i = ac_hash(w) & (ac.cap - 1);
+    while (ac.tab[i].w) {
+        if (!strcmp(ac.tab[i].w, w)) {
+            if (rank < ac.tab[i].rank) ac.tab[i].rank = rank;
+            return;
+        }
+        i = (i + 1) & (ac.cap - 1);
+    }
+    ac.tab[i].w = strdup(w);
+    ac.tab[i].rank = rank;
+    ac.n++;
+}
+
+static uint32_t
+ac_rank(const char *w)
+{
+    if (!ac.cap) return AC_NONE;
+    size_t i = ac_hash(w) & (ac.cap - 1);
+    while (ac.tab[i].w) {
+        if (!strcmp(ac.tab[i].w, w)) return ac.tab[i].rank;
+        i = (i + 1) & (ac.cap - 1);
+    }
+    return AC_NONE;
+}
+
+static void
+ac_load(const char *path, bool known)
+{
+    FILE *f = fopen(path, "r");
+    if (!f) return;
+    char line[128];
+    uint32_t rank = 1;
+    while (fgets(line, sizeof line, f)) {
+        size_t l = strcspn(line, " \t\r\n");
+        line[l] = 0;
+        if (!l || l > AC_MAXW) continue;
+        bool ok = true;
+        for (size_t i = 0; i < l; i++) {
+            line[i] = tolower((unsigned char)line[i]);
+            if (!(line[i] >= 'a' && line[i] <= 'z') && line[i] != '\'') ok = false;
+        }
+        if (ok) ac_put(line, known ? 0 : rank++);
+    }
+    fclose(f);
+    if (ac.n) ac.loaded = true;
+}
+
+/* the most frequent dictionary word one edit away from w */
+static bool
+ac_fix(const char *w, char *out)
+{
+    static const char al[] = "abcdefghijklmnopqrstuvwxyz'";
+    size_t n = strlen(w);
+    char t[AC_MAXW + 4];
+    uint32_t best = AC_NONE;
+#define AC_TRY() do { uint32_t r = ac_rank(t); if (r < best) { best = r; strcpy(out, t); } } while (0)
+    for (size_t i = 0; i <= n; i++) {                /* dont -> don't: a missing apostrophe first, */
+        memcpy(t, w, i); t[i] = '\''; memcpy(t + i + 1, w + i, n - i + 1);  /* no plain word beats it */
+        if (ac_rank(t) != AC_NONE) { strcpy(out, t); return true; }
+    }
+    for (size_t i = 0; i < n; i++) {                 /* a letter too many */
+        memcpy(t, w, i); memcpy(t + i, w + i + 1, n - i); AC_TRY();
+    }
+    for (size_t i = 0; i + 1 < n; i++) {             /* two letters swapped */
+        memcpy(t, w, n + 1); t[i] = w[i + 1]; t[i + 1] = w[i]; AC_TRY();
+    }
+    for (size_t i = 0; i < n; i++)                   /* a wrong letter */
+        for (const char *c = al; *c; c++) {
+            if (*c == w[i]) continue;
+            memcpy(t, w, n + 1); t[i] = *c; AC_TRY();
+        }
+    for (size_t i = 0; i <= n; i++)                  /* a letter missing */
+        for (const char *c = al; *c; c++) {
+            memcpy(t, w, i); t[i] = *c; memcpy(t + i + 1, w + i, n - i + 1); AC_TRY();
+        }
+#undef AC_TRY
+    return best != AC_NONE;
+}
+
+static int64_t
+ac_now_ms(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static void
+ac_reset_word(void)
+{
+    ac.len = 0;
+    ac.poison = false;
+    ac.nocorrect = false;
+}
+
+static uint32_t
+ac_code(char c)
+{
+    static const uint16_t L[26] = { KEY_A, KEY_B, KEY_C, KEY_D, KEY_E, KEY_F, KEY_G, KEY_H, KEY_I,
+        KEY_J, KEY_K, KEY_L, KEY_M, KEY_N, KEY_O, KEY_P, KEY_Q, KEY_R, KEY_S, KEY_T, KEY_U, KEY_V,
+        KEY_W, KEY_X, KEY_Y, KEY_Z };
+    return c == '\'' ? KEY_APOSTROPHE : L[c - 'a'];
+}
+
+static void
+ac_tap(struct kbd *kb, uint32_t time, uint32_t code)
+{
+    zwp_virtual_keyboard_v1_key(kb->vkbd, time, code, WL_KEYBOARD_KEY_STATE_PRESSED);
+    zwp_virtual_keyboard_v1_key(kb->vkbd, time, code, WL_KEYBOARD_KEY_STATE_RELEASED);
+}
+
+/* replace the last `erase` characters by s (first letter capital if cap0) */
+static void
+ac_replace(struct kbd *kb, uint32_t time, size_t erase, const char *s, bool cap0)
+{
+    zwp_virtual_keyboard_v1_modifiers(kb->vkbd, 0, 0, 0, 0);
+    for (size_t i = 0; i < erase; i++) ac_tap(kb, time, KEY_BACKSPACE);
+    for (size_t i = 0; s[i]; i++) {
+        zwp_virtual_keyboard_v1_modifiers(kb->vkbd, (i == 0 && cap0) ? Shift : 0, 0, 0, 0);
+        ac_tap(kb, time, dvorak_pos(ac_code(s[i])));
+    }
+    zwp_virtual_keyboard_v1_modifiers(kb->vkbd, kb->mods, 0, 0, 0);
+}
+
+static void
+ac_learn(const char *w)
+{
+    ac_put(w, 0);
+    if (!ac.known_path) return;
+    FILE *f = fopen(ac.known_path, "a");
+    if (f) { fprintf(f, "%s\n", w); fclose(f); }
+}
+
+static bool
+ac_undo(struct kbd *kb, uint32_t time)
+{
+    /* the delimiter and the corrected word go; the typed word comes back and is not corrected again */
+    ac_replace(kb, time, 1 + strlen(ac.undo_fixed), ac.undo_orig, ac.undo_cap);
+    ac_learn(ac.undo_orig);
+    ac.len = strlen(ac.undo_orig);
+    memcpy(ac.word, ac.undo_orig, ac.len);
+    memset(ac.up, 0, sizeof ac.up);
+    ac.up[0] = ac.undo_cap;
+    ac.poison = false;
+    ac.nocorrect = true;
+    return true;
+}
+
+static void
+ac_try_correct(struct kbd *kb, uint32_t time)
+{
+    ac.word[ac.len] = 0;
+    if (ac.word[ac.len - 1] == '\'') return;
+    for (size_t i = 1; i < ac.len; i++)
+        if (ac.up[i]) return;                         /* ALLCAPS, camelCase */
+    if (ac_rank(ac.word) != AC_NONE) return;          /* a word we know */
+    char fix[AC_MAXW + 4];
+    if (!ac_fix(ac.word, fix)) return;
+    ac_replace(kb, time, ac.len, fix, ac.up[0]);
+    strcpy(ac.undo_orig, ac.word);
+    strcpy(ac.undo_fixed, fix);
+    ac.undo_cap = ac.up[0];
+    ac.undo_ok = true;
+}
+
+/* Called for every key press before it is sent. Returns true when the press was handled here. */
+static bool
+ac_on_key(struct kbd *kb, struct key *k, uint32_t time)
+{
+    if (!ac.enabled || !ac.loaded) return false;
+    bool undo = ac.undo_ok;
+    ac.undo_ok = false;
+    if (k->type == Mod) return false;
+    int64_t now = ac_now_ms();
+    if (ac.len && now - ac.last_ms > AC_IDLE_MS) ac_reset_word();
+    ac.last_ms = now;
+    if (k->type != Code || k->code_mod || (kb->mods & (Ctrl | Alt | Super | AltGr))) {
+        ac_reset_word();
+        return false;
+    }
+    if (k->code == KEY_BACKSPACE) {
+        if (undo) return ac_undo(kb, time);
+        if (ac.len) ac.len--;
+        if (!ac.len) ac.nocorrect = false;
+        return false;
+    }
+    const char *lab = ((kb->mods & Shift) && k->shift_label && *k->shift_label) ? k->shift_label : k->label;
+    if (lab[0] && !lab[1] && isascii((unsigned char)lab[0]) && isalpha((unsigned char)lab[0])) {
+        if (ac.poison) return false;
+        if (ac.len >= AC_MAXW) { ac.poison = true; return false; }
+        ac.word[ac.len] = tolower((unsigned char)lab[0]);
+        ac.up[ac.len++] = (kb->mods & (Shift | CapsLock)) != 0;
+        return false;
+    }
+    if (k->code == KEY_APOSTROPHE && !(kb->mods & Shift)) {
+        if (!ac.poison && ac.len && ac.len < AC_MAXW) ac.word[ac.len++] = '\'';
+        return false;
+    }
+    bool white = k->code == KEY_SPACE || k->code == KEY_ENTER;
+    bool punct = lab[0] && !lab[1] && strchr(".,;!?)", lab[0]);
+    if (white || punct) {
+        /* before a period only longer words: www. e.g. i.e. */
+        if (ac.len >= (lab[0] == '.' ? 4 : 3) && !ac.poison && !ac.nocorrect) ac_try_correct(kb, time);
+        ac_reset_word();
+        ac.poison = !white && lab[0] == '.';          /* file.txt, e.g., www.x.com: until the next space */
+        return false;
+    }
+    ac_reset_word();                                    /* digit, symbol, arrow...: not a plain word */
+    ac.poison = true;
+    return false;
+}
+
+static void
+ac_read_state(void)
+{
+    ac.enabled = true;
+    if (!ac.state_path) return;
+    FILE *f = fopen(ac.state_path, "r");
+    if (!f) return;
+    char b[16] = "";
+    if (fgets(b, sizeof b, f) && !strncmp(b, "off", 3)) ac.enabled = false;
+    fclose(f);
+    ac_reset_word();
+    ac.undo_ok = false;
+}
+
+static void
+ac_set_enabled(bool on)
+{
+    ac.enabled = on;
+    ac_reset_word();
+    ac.undo_ok = false;
+    if (!ac.state_path) return;
+    FILE *f = fopen(ac.state_path, "w");
+    if (f) { fputs(on ? "on\n" : "off\n", f); fclose(f); }
+}
+#endif
