+/* Every key event the keyboard sends goes through vk_key, which remembers which keys are down.
+ * A key left down (its release lost) repeats in the compositor until something presses it again,
+ * so kbd_release_stuck() lets go of all of them once no finger is on the screen. */
+static inline void
+vk_send(struct zwp_virtual_keyboard_v1 *v, uint32_t t, uint32_t code, uint32_t state)
+{
+    zwp_virtual_keyboard_v1_key(v, t, code, state);
+}
+static uint8_t vk_down[768 / 8];
+static struct zwp_virtual_keyboard_v1 *vk_last;
+static void
+vk_key(struct zwp_virtual_keyboard_v1 *v, uint32_t t, uint32_t code, uint32_t state)
+{
+    vk_last = v;
+    if (code < 768) {
+        if (state == WL_KEYBOARD_KEY_STATE_PRESSED) vk_down[code / 8] |= 1 << (code % 8);
+        else vk_down[code / 8] &= ~(1 << (code % 8));
+    }
+    vk_send(v, t, code, state);
+}
+#define zwp_virtual_keyboard_v1_key vk_key
+
+void
+kbd_release_stuck(uint32_t time)
+{
+    for (uint32_t c = 1; c < 768; c++) {
+        if (!(vk_down[c / 8] & (1 << (c % 8)))) continue;
+        /* latched modifiers are down on purpose (until the next key or the Shift key is tapped again) */
+        if (c == KEY_LEFTSHIFT || c == KEY_RIGHTSHIFT || c == KEY_LEFTCTRL || c == KEY_RIGHTCTRL ||
+            c == KEY_LEFTALT || c == KEY_RIGHTALT || c == KEY_LEFTMETA || c == KEY_RIGHTMETA ||
+            c == KEY_CAPSLOCK)
+            continue;
+        vk_key(vk_last, time, c, WL_KEYBOARD_KEY_STATE_RELEASED);
+        const char *dir = getenv("XDG_RUNTIME_DIR");
+        char path[256];
+        snprintf(path, sizeof path, "%s/yoga-osk-stuck.log", dir ? dir : "/tmp");
+        FILE *f = fopen(path, "a");
+        if (f) {
+            fprintf(f, "%ld released stuck key %u\n", (long)time, c);
+            fclose(f);
+        }
+    }
+}
