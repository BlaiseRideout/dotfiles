#!/usr/bin/env python3
"""Switch the Clip Studio Paint bottle between saved sessions (docs/yoga-book/clip-studio.md).

A session is the three CELSYS folders in the bottle's Roaming appdata: login, licence state,
preferences and workspace. The one in use lives in the bottle; the others are parked in
~/.var/app/com.usebottles.bottles/data/bottles/csp-profiles/<bottle>/<id>/. Switching moves
folders (nothing is copied or deleted), so each session keeps whatever it last did.

  csp-profiles                  # the menu
  csp-profiles list
  csp-profiles switch NAME      # id or label
  csp-profiles new LABEL        # an empty session: CSP runs its first-time setup, logged out
  csp-profiles add LABEL DIR    # copy a saved appdata folder (holding CELSYS*) in as a session

$CSP_BOTTLE picks another bottle than CSP-wine11, as for clip-studio-paint.
"""
import curses
import getpass
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import quote

APP = "com.usebottles.bottles"
BOTTLE = os.environ.get("CSP_BOTTLE", "CSP-wine11")
DATA = Path.home() / ".var/app" / APP / "data/bottles"
# The two overrides are for trying this out against a scratch directory.
ROAMING = Path(os.environ.get("CSP_PROFILES_ROAMING")
               or DATA / "bottles" / BOTTLE / "drive_c/users" / getpass.getuser() / "AppData/Roaming")
STORE = Path(os.environ.get("CSP_PROFILES_STORE") or DATA / "csp-profiles" / BOTTLE)
STATE = STORE / "profiles.json"
DIRS = ("CELSYS", "CELSYS_EN", "CELSYSUserData")
LOGIN_DB = "CELSYSUserData/CELSYS/CLIPStudioCommon/Preference/LoginInfo.sqlite"

# CSP stores the login email with the bits of each character shuffled (worked out from two
# known addresses). Only used to show who a session belongs to.
_BITS = {0: 14, 1: 3, 2: 5, 3: 15, 4: 7, 5: 6, 6: 2}
_PLAIN = {chr(sum(1 << _BITS[b] for b in range(7) if c >> b & 1)): chr(c) for c in range(128)}


class Problem(Exception):
    pass


def account(root):
    """Who is logged in to the session whose three folders are in root."""
    if not any((root / d).exists() for d in DIRS):
        return "empty (first-time setup on next launch)"
    try:
        con = sqlite3.connect(f"file:{quote(str(root / LOGIN_DB))}?mode=ro&immutable=1", uri=True)
        row = con.execute("select LoginID, Token from Login limit 1").fetchone()
        con.close()
    except sqlite3.Error:
        row = None
    if not row or not row[1]:
        return "logged out"
    return "".join(_PLAIN.get(ch, "?") for ch in row[0] or "") or "logged in"


def running():
    out = subprocess.run(["flatpak", "ps", "--columns=application"], capture_output=True, text=True).stdout
    return APP in out.split()


def stop():
    subprocess.run(["flatpak", "kill", APP], capture_output=True)
    for _ in range(20):
        if not running():
            time.sleep(1)  # let the wineserver finish writing
            return
        time.sleep(0.5)
    raise Problem("Bottles did not stop")


def save(st):
    STORE.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=2) + "\n")
    tmp.replace(STATE)


def new_profile(st, label):
    base = re.sub(r"[^a-z0-9]+", "-", label.lower()).strip("-") or "session"
    pid, n = base, 2
    while any(p["id"] == pid for p in st["profiles"]) or (STORE / pid).exists():
        pid, n = f"{base}-{n}", n + 1
    (STORE / pid).mkdir(parents=True)
    st["profiles"].append({"id": pid, "label": label})
    return pid


def load():
    st = json.loads(STATE.read_text()) if STATE.exists() else {"active": None, "profiles": []}
    # A session in the bottle that no profile owns (first run, or a switch that was cut short):
    # give it a profile so switching away can never lose it.
    if st["active"] is None and any((ROAMING / d).exists() for d in DIRS):
        who = account(ROAMING)
        label = who if "@" in who else time.strftime("session found %Y-%m-%d %H:%M")
        st["active"] = new_profile(st, label)
        save(st)
    return st


def find(st, name):
    for p in st["profiles"]:
        if name in (p["id"], p["label"]):
            return p
    raise Problem(f"no session called {name!r}")


def home_of(st, pid):
    return ROAMING if pid == st["active"] else STORE / pid


def switch(st, pid):
    if pid == st["active"]:
        return
    if running():
        raise Problem("Clip Studio Paint (Bottles) is running; close it first")
    live = [d for d in DIRS if (ROAMING / d).exists()]
    if live:
        park = STORE / st["active"]
        clash = [d for d in live if (park / d).exists()]
        if clash:
            raise Problem(f"{park / clash[0]} already exists; nothing was moved")
        for d in live:
            shutil.move(ROAMING / d, park / d)
    st["active"] = None
    save(st)
    for d in DIRS:
        if (STORE / pid / d).exists():
            shutil.move(STORE / pid / d, ROAMING / d)
    st["active"] = pid
    save(st)


def copy_in(st, label, src):
    """A new session holding a copy of the CELSYS folders in src (reflinked, so it costs no space)."""
    found = [d for d in DIRS if (src / d).exists()]
    if not found:
        raise Problem(f"no CELSYS folders in {src}")
    pid = new_profile(st, label)
    for d in found:
        subprocess.run(["cp", "-a", "--reflink=auto", str(src / d), str(STORE / pid / d)], check=True)
    save(st)
    return pid


def duplicate(st, pid, label):
    if pid == st["active"] and running():
        raise Problem("close Clip Studio Paint before copying the session in use")
    return copy_in(st, label, home_of(st, pid))


def delete(st, pid):
    if pid == st["active"]:
        raise Problem("that session is in use; switch to another one first")
    trash = STORE / ".trash" / f"{pid}-{time.strftime('%Y%m%d-%H%M%S')}"
    trash.parent.mkdir(exist_ok=True)
    shutil.move(STORE / pid, trash)
    st["profiles"] = [p for p in st["profiles"] if p["id"] != pid]
    save(st)
    return trash


def launch():
    exe = Path(__file__).resolve().parent / "clip-studio-paint"
    subprocess.Popen([str(exe)], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# --- the menu ---------------------------------------------------------------------------

KEYS = "enter switch   n new fresh   d duplicate   r rename   x delete   l launch CSP   q quit"


def ask(scr, prompt):
    h, w = scr.getmaxyx()
    scr.move(h - 1, 0)
    scr.clrtoeol()
    scr.addnstr(h - 1, 0, prompt, w - 1)
    curses.echo()
    curses.curs_set(1)
    try:
        return scr.getstr(h - 1, min(len(prompt), w - 2), 60).decode(errors="replace").strip()
    finally:
        curses.noecho()
        curses.curs_set(0)


def confirm(scr, prompt):
    h, w = scr.getmaxyx()
    scr.move(h - 1, 0)
    scr.clrtoeol()
    scr.addnstr(h - 1, 0, prompt + " [y/N] ", w - 1)
    return scr.getch() in (ord("y"), ord("Y"))


def menu(scr):
    curses.curs_set(0)
    curses.use_default_colors()
    st = load()
    ids = [p["id"] for p in st["profiles"]]
    sel = ids.index(st["active"]) if st["active"] in ids else 0
    msg = ""
    while True:
        profiles = st["profiles"]
        sel = max(0, min(sel, len(profiles) - 1))
        h, w = scr.getmaxyx()
        scr.erase()
        scr.addnstr(0, 1, f"Clip Studio Paint sessions  ({BOTTLE})", w - 2, curses.A_BOLD)
        wide = max([len(p["label"]) for p in profiles] + [8])
        for i, p in enumerate(profiles[: h - 5]):
            used = p["id"] == st["active"]
            who = account(home_of(st, p["id"]))
            line = f" {'●' if used else ' '} {p['label']:<{wide}}  {'' if who == p['label'] else who}"
            line += "  [in use]" if used else ""
            attr = (curses.A_REVERSE if i == sel else 0) | (curses.A_BOLD if used else 0)
            scr.addnstr(2 + i, 1, line.ljust(w - 3), w - 2, attr)
        if not profiles:
            scr.addnstr(2, 1, "No sessions yet. Press n to make one.", w - 2)
        scr.addnstr(h - 3, 1, KEYS, w - 2, curses.A_DIM)
        scr.addnstr(h - 2, 1, msg, w - 2)
        scr.refresh()
        k = scr.getch()
        msg = ""
        cur = profiles[sel] if profiles else None
        try:
            if k in (ord("q"), 27):
                return
            elif k in (curses.KEY_UP, ord("k")):
                sel -= 1
            elif k in (curses.KEY_DOWN, ord("j")):
                sel += 1
            elif k == ord("n"):
                label = ask(scr, "Name for the fresh session: ")
                if label:
                    pid = new_profile(st, label)
                    save(st)
                    sel = len(st["profiles"]) - 1
                    msg = f"Made '{label}' (empty). Press enter to switch to it."
            elif k == ord("l"):
                launch()
                msg = "Starting Clip Studio Paint..."
            elif cur is None:
                pass
            elif k in (curses.KEY_ENTER, 10, 13):
                if cur["id"] == st["active"]:
                    msg = f"'{cur['label']}' is already in use."
                elif not running() or confirm(scr, "Clip Studio Paint is running. Close it (unsaved work is lost)?"):
                    if running():
                        stop()
                    switch(st, cur["id"])
                    msg = f"Now using '{cur['label']}'. Press l to launch."
            elif k == ord("d"):
                label = ask(scr, f"Name for the copy of '{cur['label']}': ")
                if label:
                    duplicate(st, cur["id"], label)
                    msg = f"Copied to '{label}'."
            elif k == ord("r"):
                label = ask(scr, f"New name for '{cur['label']}': ")
                if label:
                    cur["label"] = label
                    save(st)
            elif k == ord("x"):
                if confirm(scr, f"Delete '{cur['label']}'?"):
                    msg = f"Moved to {delete(st, cur['id'])}"
        except (Problem, OSError, subprocess.CalledProcessError) as e:
            msg = f"Error: {e}"


def main(argv):
    try:
        if not argv:
            if not ROAMING.is_dir():
                raise Problem(f"no bottle appdata at {ROAMING}")
            curses.wrapper(menu)
            return
        st = load()
        cmd, args = argv[0], argv[1:]
        if cmd == "list" and not args:
            for p in st["profiles"]:
                mark = "*" if p["id"] == st["active"] else " "
                print(f"{mark} {p['id']:<28} {p['label']:<32} {account(home_of(st, p['id']))}")
        elif cmd == "switch" and len(args) == 1:
            switch(st, find(st, args[0])["id"])
        elif cmd == "new" and len(args) == 1:
            new_profile(st, args[0])
            save(st)
        elif cmd == "add" and len(args) == 2:
            copy_in(st, args[0], Path(args[1]))
        else:
            sys.exit(__doc__)
    except Problem as e:
        sys.exit(f"csp-profiles: {e}")


if __name__ == "__main__":
    main(sys.argv[1:])
