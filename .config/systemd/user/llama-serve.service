[Unit]
Description=LLaMA Serve Router Server
After=network.target
# Models live in ~/.local/share/huggingface (~/.cache/huggingface is a symlink to it)

[Service]
Type=simple
ExecStart=/home/blaise/.llama-app/llama serve \
    --device CUDA0 \
    --gpu-layers auto \
    --models-max 1 \
    --models-preset /home/blaise/.config/llama-serve/models.ini \
    --fit on \
    --fit-target 1536 \
    --cache-type-k q8_0 \
    --cache-type-v q8_0 \
    --sleep-idle-seconds 240 \
    --api-key-file /home/blaise/.local/state/llama-serve/api-key \
    --metrics
# The API key lives outside the repo; create it (random) on first start. Clients read it with `llama-key`/llama_curl.
ExecStartPre=/home/blaise/.local/bin/llama-key ensure
# Reload whichever model was resident when the service last stopped
ExecStartPost=-/home/blaise/.local/bin/llama-state restore
ExecStop=-/home/blaise/.local/bin/llama-state save $MAINPID
Restart=on-failure
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=120
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
KillSignal=SIGINT
TimeoutStopSec=30
Nice=0
MemoryMax=16G
IOWeight=300

[Install]
WantedBy=default.target
