{
  "outer_padding": 0,
	"segments": {
		"above": [{
      "left": [
        {"type": "string", "contents": "", "highlight_groups": ["rounded_user_cap"], "draw_soft_divider": false, "draw_hard_divider": false},
        {
          "function": "powerline.segments.shell.mode"
        },
        {
          "function": "powerline.segments.common.net.hostname",
          "priority": 10
        },
        {
          "function": "powerline.segments.common.env.user",
          "before": " ",
          "priority": 30
        },
        {
          "function": "powerline.segments.common.time.date",
          "args": {
            "istime": true,
            "format": "%H:%M"
          },
          "priority": 20
        },
        {
          "function": "powerline.segments.common.env.virtualenv",
          "priority": 50
        },
        {
          "function": "powerline.segments.shell.cwd",
          "dir_limit_depth": 5,
          "priority": 10
        },
        {
          "function": "powerline.segments.shell.jobnum",
          "priority": 20
        }
      ],

      "right": [
        {
          "type": "string",
          "highlight_groups": ["rounded_branch_fill"],
          "draw_soft_divider": false,
          "draw_hard_divider": false,
          "width": "auto"
        },
        {
          "function": "powerline.segments.shell.last_pipe_status",
          "priority": 10
        },
        {
          "function": "powerline.segments.common.vcs.stash",
          "priority": 50
        },
        {
          "function": "powerline.segments.common.vcs.branch",
          "priority": 40
        },
        {"type": "string", "contents": "", "highlight_groups": ["rounded_branch_cap"], "draw_soft_divider": false, "draw_hard_divider": false}
      ]
		}],
    "left": [
      {"type": "string", "contents": "", "highlight_groups": ["rounded_prompt_cap"], "draw_soft_divider": false, "draw_hard_divider": false},
      {
        "type": "string",
        "contents": "$",
        "highlight_groups": ["continuation:current"],
        "draw_soft_divider": false,
        "draw_hard_divider": false
      },
      {"type": "string", "contents": " ", "highlight_groups": ["rounded_prompt_cap"], "draw_soft_divider": false, "draw_hard_divider": false}
    ],
    "right": []
	}
}
