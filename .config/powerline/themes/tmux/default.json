{
  "outer_padding": 0,
  "dividers": {
    "left": {"hard": "", "soft": ""},
    "right": {"hard": "", "soft": ""}
  },
	"segments": {
		"right": [
			{
				"function": "powerline.segments.common.time.date",
        "after": " ",
        "args": {
          "istime": false,
          "format": "%B %d, %Y"
        }
			},
			{
				"function": "powerline.segments.common.time.date",
        "after": " ",
				"name": "time",
				"args": {
					"format": "%H:%M",
					"istime": true
				}
			},
			{
				"function": "powerline.segments.common.env.environment",
        "after": " ",
				"args": {
          "variable": "TMUX_ACTIVE"
        }
			},
			{
				"function": "powerline.segments.common.net.hostname",
        "after": " ",
        "args": { "only_if_ssh": false }
			}
      , {"type": "string", "contents": "", "highlight_groups": ["rounded_hostname_cap"], "draw_soft_divider": false, "draw_hard_divider": false}
		]
	}
}
