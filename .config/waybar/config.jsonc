// -*- mode: jsonc -*-
// Two bars built from bar.jsonc, which holds the module definitions. The primary monitor gets
// every indicator; every other output only gets the clock and the tray. launch.sh sets WAYBAR_PRIMARY to the primary output
// (the largest external monitor, else the laptop panel; same rule as kanshi/move_workspaces.sh)
// and restarts Waybar when it changes. Entries are checked in order, so the exclusion comes
// before "*". Without the variable, no output counts as primary and just the plain bar shows.
[
    {
        "output": ["$WAYBAR_PRIMARY"],
        "include": ["~/.config/waybar/bar.jsonc"],
        "modules-right": [
            "custom/media",
            "custom/makomode",
            "idle_inhibitor",
            "pulseaudio",
            // "network",
            // "power-profiles-daemon",
            "memory",
            "cpu#freq",
            "cpu",
            "temperature",
            "custom/gpu",
            "custom/gputemp",
            "custom/llama",
            "backlight",
            //"sway/language", // hide-single-layout needs a newer waybar than 0.9.24; only one layout is configured
            "custom/zmkbattery",
            "battery",
            //"custom/clockworkaround",
            "clock",
            "tray"
        ]
    },
    {
        "output": ["!$WAYBAR_PRIMARY", "*"],
        "include": ["~/.config/waybar/bar.jsonc"],
        "modules-right": ["clock", "tray"]
    }
]
